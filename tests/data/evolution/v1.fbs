// Schema evolution, version 1. v2.fbs evolves it the ways FlatBuffers allows.
namespace evo;

enum Color : ubyte { Red, Green }

table Weapon {
  name: string;
  damage: short = 10;
}

union Item { Weapon }

table Ship {
  name: string (key);
  hp: int = 100;
  color: Color = Green;
  item: Item;
  tags: [string];
  legacy: int;
}

table Fleet {
  ships: [Ship];
}

root_type Fleet;
